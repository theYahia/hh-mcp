# hh-mcp configuration — copy to .env.local and fill in as needed.
# All variables are optional; the server runs against public hh.ru endpoints
# without any of them.

# OAuth 2.0 Bearer token for hh.ru. Required ONLY for resume endpoints
# (search_resumes / get_resume), which additionally need an employer account
# with a paid resume-database subscription. Get one at https://dev.hh.ru/admin
HH_ACCESS_TOKEN=

# hh.ru REQUIRES an HH-User-Agent header and recommends a contact address.
# Override the default with your own app name + contact email.
# Example: my-job-bot/1.0 (me@example.com)
HH_USER_AGENT=

# --- HTTP mode (only when started with --http or HTTP_PORT set) ---

# Port for HTTP mode (default: 3000). PORT is also honored.
HTTP_PORT=3000

# Interface to bind in HTTP mode (default: 127.0.0.1). Set to 0.0.0.0 to expose.
HOST=127.0.0.1

# DNS-rebinding protection allow-lists for HTTP mode. Comma-separated.
# Defaults to 127.0.0.1:<port>,localhost:<port>. If you bind to a public host,
# add it here or legitimate requests get a 403.
HH_ALLOWED_HOSTS=
HH_ALLOWED_ORIGINS=
